# Заплатка Wi-Fi узла. Названа заплаткой честно: причина на стороне точки
# доступа не устранена, служба лишь держит ассоциацию живой редким пингом.
#
# Линк рвётся ровно тогда, когда простаивает: 2026-08-10 обрывы прекратились
# на все 20 минут, пока шёл опрос раз в минуту, и вернулись через минуту после
# его остановки. Сигнал при этом хороший (-54 дБм, ноль потерянных маяков),
# то есть дело не в дальности.
#
# До 31 августа юнит жил только на узле и в репозитории отсутствовал: после
# переустановки узла его было бы неоткуда взять, а без него узел молча теряет
# домашнюю сеть. Ставится установщиком только если уже включён на узле или по
# явной просьбе (CATDOOR_WIFI_KEEPALIVE=1): на проводном узле он не нужен.
[Unit]
Description=CatDoor: keepalive домашнего Wi-Fi узла
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ping -i 20 -n -q 192.168.2.1
Restart=always
RestartSec=10
Nice=19

[Install]
WantedBy=multi-user.target
