[Unit]
Description=CatDoor — привести контур калитки к состоянию узла
Documentation=https://github.com/alexdeshov/cat_door/blob/main/docs/two-circuits-plan.md
After=docker.service
Wants=docker.service

# Примиритель читает инвентарь камер из каталога данных и пишет конфигурацию
# Frigate в его каталог — оба на отдельных томах, о которых юнит сам не знает.
# 2026-08-09 такая же незаявленная зависимость у Frigate стоила четырёх часов
# записи не на тот диск и мёртвого распознавания лиц.
RequiresMountsFor=/var/lib/catdoor /var/lib/frigate

[Service]
# От root, потому что исполняет systemctl. Веб-служба остаётся без привилегий:
# она только записывает желаемое состояние в runtime/circuits.json.
Type=oneshot
WorkingDirectory=/opt/catdoor
EnvironmentFile=/etc/catdoor/catdoor.env
ExecStart=/opt/catdoor/.venv/bin/python -m src.common.gate_sync
# `systemctl start frigate` блокируется до готовности контейнера, а у той
# службы таймаут 900 секунд. С умолчанием в 90 примиритель умирал бы раньше,
# чем Frigate поднимется, — и именно при холодном старте, где это дольше всего.
TimeoutStartSec=900

[Install]
# Один прогон при загрузке: контейнер Frigate объявлен с restart: "no", и без
# этого узел, отданный калитке, поднялся бы с остановленным контуром.
WantedBy=multi-user.target
