[Unit]
Description=CatDoor — привести контур калитки к состоянию узла
Documentation=https://github.com/alexdeshov/cat_door/blob/main/docs/two-circuits-plan.md
After=docker.service
Wants=docker.service

[Service]
# От root, потому что исполняет systemctl. Веб-служба остаётся без привилегий:
# она только записывает желаемое состояние в runtime/circuits.json.
Type=oneshot
WorkingDirectory=/opt/catdoor
EnvironmentFile=/etc/catdoor/catdoor.env
ExecStart=/opt/catdoor/.venv/bin/python -m src.common.gate_sync

[Install]
# Один прогон при загрузке: контейнер Frigate объявлен с restart: "no", и без
# этого узел, отданный калитке, поднялся бы с остановленным контуром.
WantedBy=multi-user.target
