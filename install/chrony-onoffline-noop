#!/bin/sh
# Заглушка хука chrony для networkd-dispatcher. Кладётся установщиком в
# /etc/networkd-dispatcher/{routable,off}.d/chrony-onoffline и тем самым
# перекрывает одноимённый хук пакета chrony из /usr/lib.
#
# Пакетный хук зовёт `chronyc onoffline`, а тот переводит в offline каждый
# источник, до которого в этот миг нет маршрута. На Wi-Fi узла это гонка:
# 2026-09-27 17:05 линк переподключился, DHCPv6 отдал адрес раньше DHCPv4,
# интерфейс стал routable без IPv4-маршрута — и все восемь серверов ушли в
# offline. Маршрут появился через две секунды, но состояние интерфейса уже не
# менялось, хук второй раз не позвали, и chrony молчал до ручного вмешательства:
# через девять часов ядро сняло флаг синхронизации, сторож поднял тревогу.
#
# Узел включён круглосуточно, беречь пакеты ему незачем: без offline chrony
# просто не получит ответов, пока нет сети, и сам подхватит их, когда она
# вернётся.
exit 0
