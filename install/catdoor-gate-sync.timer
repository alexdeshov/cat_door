[Unit]
Description=CatDoor — регулярная сверка контура калитки
Documentation=https://github.com/alexdeshov/cat_door/blob/main/docs/two-circuits-plan.md

[Timer]
# Path-юнит срабатывает по фронту изменения файла, и фронт, пришедший во время
# прогона примирителя, теряется — systemd не ставит их в очередь. Быстрое
# двойное переключение оставляло узел в противоположном состоянии до следующего
# щелчка. Таймер превращает примирение из событийного в регулярное: любое
# расхождение — потерянный фронт, умерший контейнер, обгон при загрузке —
# сходится не позже чем за две минуты.
OnBootSec=90
OnUnitActiveSec=120

[Install]
WantedBy=timers.target
