[Unit]
Description=CatDoor admin interface
Documentation=https://github.com/alexdeshov/cat_door/blob/main/docs/deployment-ubuntu.md
After=network-online.target
Wants=network-online.target
# Без этого действует умолчание systemd — пять запусков за десять
# секунд, и юнит остаётся в `failed`. Обещание ниже «никогда не
# сдаваться» иначе держится только на том, что RestartSec больше
# этого окна: измени его кто-нибудь, и узел молча перестанет
# подниматься после череды сбоев.
StartLimitIntervalSec=0

# Каталог данных лежит на отдельном томе, и systemd сам про него не знает:
# путь приходит из окружения, а не из юнита. Без этой строки служба стартует
# раньше монтирования и пишет в пустой каталог под точкой монтирования.
#
# 2026-08-09 ровно это случилось с Frigate: контейнер поднялся на 2.3 секунды
# раньше тома, четыре часа писал записи не на тот диск и не видел библиотеки
# лиц. Гонка проигрывалась и при чистой загрузке — просто её маскировали наши
# же перезапуски по другим поводам.
RequiresMountsFor=/var/lib/catdoor

[Service]
Type=notify
NotifyAccess=main
# The admin interface pings from a background task on the event loop, so a
# blocked loop stops the pings even while the process is alive.
WatchdogSec=60

User=catdoor
Group=catdoor
WorkingDirectory=/opt/catdoor
EnvironmentFile=/etc/catdoor/catdoor.env
ExecStart=/opt/catdoor/.venv/bin/python -m src.web.app

# Долгую работу админка отдаёт отдельным процессам: пересчёт эталонов — час,
# офлайн-замер — дольше. `start_new_session` в `spawn_detached` спасает их от
# SIGHUP, но не от systemd: по умолчанию (`KillMode=control-group`) остановка
# службы убивает **всю** её контрольную группу, детей вместе с родителем.
#
# 2026-08-12 это стоило владельцу дня работы: пересчёт эталонов, запущенный в
# 09:30, умер в 10:29:49 вместе с перезапуском админки в 10:30:03. Восемь часов
# после этого страница показывала «Готовлю кадры размеченных проходов».
#
# `KillMode=process` останавливает только главный процесс. Дети переживают
# перезапуск и доводят работу до конца — а брошенных отличает записанный в
# состоянии `pid`, по которому админка видит, что процесса больше нет.
KillMode=process

Restart=always
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=1800

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/catdoor

[Install]
WantedBy=multi-user.target
