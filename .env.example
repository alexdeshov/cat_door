# Camera network (never commit a real URL with credentials)
#
# Только начальное значение. При первом запуске из этих переменных собирается
# инвентарь data/runtime/cameras.json, дальше камеры редактируются на вкладке
# «Камеры» в админке, а переменные больше не читаются. Так перестановка камеры
# не требует правки конфигурации и перезапуска служб.
CATDOOR_CAMERA_FACE_RTSP=
CATDOOR_CAMERA_SIDE_RTSP=
# Обе уличные камеры стоят прямо; флаг поворота живёт в карточке камеры и
# правится там же. Эти значения — только семя первого запуска.
CATDOOR_CAMERA_FACE_ROTATE_180=false
CATDOOR_CAMERA_SIDE_ROTATE_180=false

# Paths (absolute; the services run with WorkingDirectory=/opt/catdoor)
CATDOOR_DATA_DIR=/var/lib/catdoor
CATDOOR_DATABASE_PATH=/var/lib/catdoor/catdoor.sqlite3
CATDOOR_FFMPEG_PATH=ffmpeg

# Дополнительные камеры для первого заполнения инвентаря. Детектор, события и
# обучение работают с ролями face и side; камера без роли доступна для
# просмотра. Значение — JSON в одну строку; id попадает в адрес потока, поэтому
# только a-z, 0-9, дефис и подчёркивание. Запись с id роли переопределяет её
# адрес. Дальше камеры добавляются на вкладке «Камеры», а не здесь.
# CATDOOR_CAMERAS=[{"id":"yard","rtsp":"rtsp://USER:PASSWORD@CAMERA_IP:554/Streaming/Channels/102","title":"Двор","rotate_180":false}]

# Поиск камер на вкладке «Камеры». Подсеть — сеть камер, а не та, через которую
# администратор пришёл на сервер: по ней идёт обход RTSP-порта и через неё
# отправляется ONVIF-проба. Без неё поиск ограничен арендами DHCP и ARP.
CATDOOR_CAMERA_DISCOVERY_SUBNET=192.168.1.0/24
# CATDOOR_CAMERA_DHCP_LEASES_PATH=/var/lib/misc/dnsmasq.leases
# CATDOOR_CAMERA_ARP_TABLE_PATH=/proc/net/arp
# CATDOOR_CAMERA_DISCOVERY_TIMEOUT_SECONDS=3

# Порог свободного места: ниже него новые записи не начинаются, чтобы диск,
# заполненный до конца, не заглушил заодно статус, журнал и базу.
# CATDOOR_DISK_MIN_FREE_GB=2

# Живучесть. Сколько recorder ждёт кадр, прежде чем счесть поток застрявшим,
# убить ffmpeg и переподключиться. Должно превышать самую медленную настроенную
# частоту кадров с запасом на переподключение.
# CATDOOR_CAMERA_STALL_SECONDS=30
# Через сколько секунд молчания закрывается живое превью в админке: каждая
# открытая вкладка — отдельный процесс ffmpeg на сервере.
# CATDOOR_PREVIEW_IDLE_TIMEOUT_SECONDS=20
# Сколько превью держится за пропавшую камеру, показывая «нет сигнала» и
# переоткрывая поток, — столько времени картинка оживает сама, без F5.
# CATDOOR_PREVIEW_SILENCE_LIMIT_SECONDS=300

# Контур калитки: служба systemd, поднимающая Frigate, и адрес его интерфейса.
# Пустой адрес — ссылка на пульте не показывается. Службу включает и выключает
# примиритель catdoor-gate-sync от root: у веб-процесса привилегий нет.
# CATDOOR_GATE_SERVICE_UNIT=frigate.service
# CATDOOR_GATE_UI_URL=http://192.168.0.10:5000
# Куда примиритель пишет конфигурацию Frigate, собранную из инвентаря камер.
# Путь — каталог, смонтированный в контейнер как /config: Frigate мигрирует
# конфигурацию сам и держит там же свою базу.
# CATDOOR_GATE_CONFIG_PATH=/var/lib/frigate/config/config.yml
# Копия прошлой сборки: сравнивать нужно с ней, а не с рабочим файлом, который
# Frigate переписывает при миграции.
# CATDOOR_GATE_APPLIED_CONFIG_PATH=/etc/frigate/catdoor-applied.yml
# Пароли камер: в config.yml остаются только ссылки на переменные.
# CATDOOR_GATE_ENV_PATH=/etc/frigate/frigate.env

# Web
# The admin UI has no authentication: it can delete events and open camera
# streams. Binding to 0.0.0.0 is only safe behind a firewall rule that limits
# port 8080 to the home subnet. Use 127.0.0.1 plus an SSH tunnel otherwise.
CATDOOR_WEB_HOST=0.0.0.0
CATDOOR_WEB_PORT=8080
# Часовой пояс админки и архива Frigate. В базе время хранится в UTC, а на
# экране показывается в этом поясе. Имя из базы IANA.
CATDOOR_DISPLAY_TIMEZONE=Europe/Moscow

# Runtime
CATDOOR_PREVIEW_FPS=5
CATDOOR_CAPTURE_DURATION_SECONDS=8
# Начальное положение переключателя сбора на главной странице админки. После
# первого переключения режим живёт в data/runtime/capture-mode.json, и эти
# переменные больше не читаются.
CATDOOR_AUTOMATIC_CAPTURE_ENABLED=false
CATDOOR_AUTOMATIC_CAPTURE_DRY_RUN=true
CATDOOR_DETECTOR_MODEL_PATH=/var/lib/catdoor/models/cat-detector.onnx
# Set GPU explicitly only after checking openvino.Core().available_devices.
CATDOOR_DETECTOR_DEVICE=CPU
# CATDOOR_IDENTITY_FACE_MODEL_PATH=/var/lib/catdoor/models/face-identity.onnx
# CATDOOR_IDENTITY_SIDE_MODEL_PATH=/var/lib/catdoor/models/side-identity.onnx
# CATDOOR_IDENTITY_PRETRAINED_WEIGHTS_PATH=/var/lib/catdoor/models/mobilenet_v3_small-imagenet.pth
CATDOOR_IDENTITY_CONFIDENCE_THRESHOLD=0.80
# Настройки детекции — только начальное значение при первом старте. Дальше они
# живут в data/runtime/detection-settings.json и правятся на вкладке «Камеры»
# без перезапуска служб; правка этих переменных после первого старта ни на что
# не влияет. Тот же механизм, что у инвентаря камер, и та же ловушка: файл
# может годами показывать одно, а работать будет другое. Что стоит на самом
# деле — `curl localhost:8080/api/detection/settings`.
CATDOOR_DETECTOR_FACE_SAMPLE_FPS=8
CATDOOR_DETECTOR_SAMPLE_FPS=3
CATDOOR_RING_SEGMENT_SECONDS=2
CATDOOR_RING_RETENTION_SECONDS=180
CATDOOR_AUTOMATIC_PREBUFFER_SECONDS=12
# Пороги детекции — тоже только первое значение, см. оговорку выше.
CATDOOR_DETECTION_CONFIDENCE_THRESHOLD=0.55
CATDOOR_DETECTION_BOX_MIN_CONFIDENCE=0.20
CATDOOR_DETECTION_CONFIRMATION_FRAMES=2
CATDOOR_DETECTION_WINDOW_FRAMES=5
CATDOOR_DETECTION_CANDIDATE_TIMEOUT_SECONDS=3
CATDOOR_DETECTION_ABSENCE_SECONDS=3
CATDOOR_DETECTION_TAIL_SECONDS=10
CATDOOR_DETECTION_COOLDOWN_SECONDS=5
# Потолок длительности одной записи: заснувший у дверцы кот иначе записал бы
# диск досуха. Ноль — без лимита.
CATDOOR_DETECTION_MAX_EVENT_SECONDS=60
CATDOOR_LOCAL_TRAINING_EPOCHS=2
